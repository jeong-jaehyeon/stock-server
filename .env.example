# stock-server 환경 변수 템플릿 — 복사해서 .env로 사용 (실제 값은 커밋 금지)
# cp .env.example .env
PORT=3000

DB_NAME=stock_db
DB_USER=root
DB_PASSWORD=yourpassword
DB_HOST=localhost

TWELVE_DATA_API_KEY=your_api_key
JWT_SECRET=your_jwt_secret_min_32_chars

# 테스트용 (테스트 setup이 자동으로 sqlite in-memory로 덮어씀)
# DATABASE_DIALECT=sqlite
# DATABASE_STORAGE=:memory:
